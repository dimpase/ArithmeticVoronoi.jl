cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED AV_HASH_FILE)
  set(AV_HASH_FILE "${AV_EXECUTABLE}")
endif()
file(SHA256 "${AV_HASH_FILE}" _hash)
file(MAKE_DIRECTORY "${AV_OUTPUT_DIRECTORY}")

function(av_json_quote output value)
  string(REPLACE "\\" "\\\\" _value "${value}")
  string(REPLACE "\"" "\\\"" _value "${_value}")
  string(REPLACE "\n" "\\n" _value "${_value}")
  string(REPLACE "\r" "\\r" _value "${_value}")
  string(REPLACE "\t" "\\t" _value "${_value}")
  set(${output} "\"${_value}\"" PARENT_SCOPE)
endfunction()

av_json_quote(_executable "${AV_EXECUTABLE}")
string(JSON _config SET "{}" schema "\"av_backend_config_v1\"")
string(JSON _config SET "${_config}" executable "${_executable}")
string(JSON _config SET "${_config}" executable_sha256 "\"${_hash}\"")
string(JSON _config SET "${_config}" commit "\"@AV_BACKEND_COMMIT@\"")
# Both historical selectors now install together and use the all-field binary.
foreach(_name IN ITEMS config.json config_fields.json)
  file(WRITE "${AV_OUTPUT_DIRECTORY}/${_name}" "${_config}\n")
endforeach()

set(_info "${_config}")
string(JSON _info SET "${_info}" schema "\"av_backend_build_v1\"")
set(_pins [====[@AV_BACKEND_PINS@]====])
string(JSON _info SET "${_info}" dependency_pins "${_pins}")
set(_source [====[@polyhedral_common_SOURCE_DIR@]====])
set(_compiler [====[@CMAKE_CXX_COMPILER@]====])
set(_compiler_version "@CMAKE_CXX_COMPILER_VERSION@")
set(_cmake_version "@CMAKE_VERSION@")
set(_generator "@CMAKE_GENERATOR@")
set(_build_configuration "${AV_BUILD_CONFIG}")
set(_gmp_version "@GMPXX_VERSION@")
set(_eigen_version "@Eigen3_VERSION@")
set(_boost_version "@Boost_VERSION@")
set(_nauty_provider "SYSTEM")
set(_nauty_library [====[@Nauty_LIBRARY@]====])
set(_nauty_version "@Nauty_VERSION@")
foreach(_key IN ITEMS source compiler compiler_version cmake_version generator
    build_configuration gmp_version eigen_version boost_version
    nauty_provider nauty_library nauty_version)
  av_json_quote(_value "${_${_key}}")
  string(JSON _info SET "${_info}" "${_key}" "${_value}")
endforeach()
string(JSON _info SET "${_info}" sanitizers false)
if("@AV_ENABLE_SANITIZERS@")
  string(JSON _info SET "${_info}" sanitizers true)
endif()
string(JSON _info SET "${_info}" exporter_source_sha256 "\"@AV_EXPORTER_SHA256@\"")
file(WRITE "${AV_OUTPUT_DIRECTORY}/backend-build.json" "${_info}\n")
