set(_bindir "@CMAKE_INSTALL_BINDIR@")
if(NOT IS_ABSOLUTE "${_bindir}")
  set(_bindir "${CMAKE_INSTALL_PREFIX}/${_bindir}")
endif()
set(AV_EXECUTABLE "${_bindir}/AV_ExportPerfectOrbits@CMAKE_EXECUTABLE_SUFFIX@")
set(AV_HASH_FILE "$ENV{DESTDIR}${AV_EXECUTABLE}")
set(AV_OUTPUT_DIRECTORY "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(AV_BUILD_CONFIG "${CMAKE_INSTALL_CONFIG_NAME}")
include("@CMAKE_CURRENT_BINARY_DIR@/WriteBackendInfo.cmake")
message(STATUS "Installed backend selectors and build provenance in ${AV_OUTPUT_DIRECTORY}")
